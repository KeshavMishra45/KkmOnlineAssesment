# Copy this file to .env (and .env.local for anything secret) and fill in
# real values. Never commit your real .env file.

# --- MongoDB Atlas -----------------------------------------------------
# Atlas dashboard -> Database -> Connect -> "Drivers" -> copy the connection
# string, then swap in your database user's username/password.
# Example: mongodb+srv://kkm_app:REPLACE_ME@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
# Logical database name inside the cluster (any name you like).
MONGODB_DB=kkm_classroom

# --- Auth ---------------------------------------------------------------
# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Code runner (already used by the coding-exam feature) --------------
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_KEY=
